model UserFaces {
  id     String @id @default(uuid())
  userId String @unique
  user   Users  @relation(fields: [userId], references: [id])

  // Data wajah dalam bentuk Binary (BLOB/ByteA)
  faceData Bytes @db.ByteA

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



// & POINT WALLET (DOMPET INTEGRITAS) MODELS
// & Dynamic Rule Engine, Transaction Ledger, Marketplace Catalog, Token Inventory
// % Model Sistem Dompet Integritas: Mesin Aturan Dinamis, Buku Besar, Katalog Marketplace, Inventory Token

// & Point Rules: Dynamic rule engine for automated point calculation
// % Aturan Poin: Mesin aturan dinamis untuk kalkulasi poin otomatis
model PointRules {
  id              String   @id @default(uuid())
  ruleName        String   // "Datang Pagi Banget", "Terlambat 15+ Menit"
  targetRole      String   // "USER", "ADMIN", "HR" (dari RbacRoles.key)
  
  // & Condition: JIKA jam_check_in < 06:30 MAKA +5
  // % Kondisi: IF jam_check_in < 06:30 THEN +5
  conditionField  String   // "check_in_time" | "late_minutes" | "attendance_status"
  conditionOp     String   // "<", ">", "==", "between", "in"
  conditionValue  String   // "06:30:00" | "15" | "LATE"
  
  pointModifier   Int      // +5, -3, 0 (dapat positif atau negatif)
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isActive, targetRole])
}


// & Enum untuk Tipe Transaksi Poin
// % Enum for Point Transaction Types
enum TransactionType {
  EARN
  SPEND
  PENALTY
  ADJUSTMENT
}

// & Point Ledgers: Audit trail / bank-style transaction tracking for all point mutations
// % Buku Besar Poin: Jejak audit / pencatatan transaksi ala bank untuk semua mutasi poin
model PointLedgers {
  id              String   @id @default(uuid())
  userId          String
  user            Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  transactionType TransactionType
  amount          Int      // +5, -3 (signed)
  balanceBefore   Int      // Saldo sebelum transaksi
  balanceAfter    Int      // Saldo sesudah transaksi
  
  description     String?  @db.Text // "Check-in tepat waktu 12/08/2024"
  referenceEntity String?  // "attendance", "token_purchase", "rule_trigger"
  referenceId     String?  // FK ke attendance.id atau transaction lain
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId, createdAt])
  @@index([transactionType])
}

// & Flexibility Items: Marketplace catalog for tradeable rewards (tokens)
// % Item Fleksibilitas: Katalog marketplace untuk reward yang bisa ditukar (token)
model FlexibilityItems {
  id              String   @id @default(uuid())
  itemName        String   // "Bebas Terlambat 15 Menit", "Izin Tanpa Surat"
  pointCost       Int      // 20, 50, 100
  
  itemType        String   // "late_allowance", "absence_excuse", "wfh", "overtime"
  durationDays    Int      // 1, 7, 30 (masa berlaku token)
  maxPerMonth     Int?     // Stock limit per user per bulan (nullable = unlimited)
  conditionField  String?  // "attendance.status" | "attendance.lateMinutes"
  conditionValue  String?  // "ABSENT" | "30"
  expiredAt       DateTime? // Masa aktif listing item di marketplace
  
  description     String?  @db.Text
  iconUrl         String?  // URL ilustrasi dari cloudinary
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  userTokens      UserTokens[]

  @@index([isActive, expiredAt])
}

// & User Tokens: User inventory of purchased flexibility tokens
// % Token Pengguna: Inventory token fleksibilitas yang dibeli pengguna
model UserTokens {
  id              String   @id @default(uuid())
  userId          String
  user            Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  itemId          String
  item            FlexibilityItems @relation(fields: [itemId], references: [id], onDelete: Restrict)
  
  status          String   // "AVAILABLE", "USED", "EXPIRED"
  usedAt          DateTime?        // Kapan token ini digunakan
  
  // & Back-reference to attendance where this token was used
  // % Referensi balik ke absensi dimana token ini dipakai
  attendance      Attendances? @relation("AttendanceUsedToken")
  
  expiresAt       DateTime // Token berlaku sampai kapan
  remainingDays   Int      @default(0) // Cache sisa hari, disinkronkan dari expiresAt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId, status])
  @@index([expiresAt])
}
