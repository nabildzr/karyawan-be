model Geofences {
  id                  String        @id @default(uuid())
  name                String
  latitude            Decimal       @db.Decimal(10, 7)
  longitude           Decimal       @db.Decimal(10, 7)
  radius              Int // dalam meter
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  attendancesCheckIn  Attendances[] @relation("AttendanceCheckIn")
  attendancesCheckOut Attendances[] @relation("AttendanceCheckOut")
}

// & Submission enums and models used by employee request workflow.
// % Enum dan model pengajuan yang dipakai alur request karyawan.
enum SubmissionType {
  IZIN_SAKIT
  IZIN_KHUSUS
  DINAS_LUAR
  LEMBUR
}

enum SubmissionStatus {
  PENDING // Menunggu (Warna Kuning/Abu)
  APPROVED // Disetujui (Warna Hijau)
  REJECTED // Ditolak (Warna Merah)
}

// ==========================================
// & MODEL PENGAJUAN
// ==========================================
model Submissions {
  id     String @id @default(uuid())
  userId String

  // Data dari Form Karyawan
  type       SubmissionType // Dropdown "Tipe Pengajuan"
  startDate  DateTime // "Tanggal Mulai"
  endDate    DateTime // "Tanggal Selesai"
  reason     String         @db.Text // Text Area "Alasan"
  attachment String? // URL file lampiran di Cloudinary
  attachmentPublicId String? // public_id Cloudinary untuk kebutuhan cleanup saat delete
  attachmentOriginalName String?
  attachmentMimeType String?
  attachmentSizeBytes Int?

  // Data dari HRD / Sistem
  status          SubmissionStatus @default(PENDING) // Status awal selalu PENDING
  rejectionReason String?          @db.Text // Alasan kalau ditolak HRD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke tabel Users yang udah lu punya
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// & Work schedule models for shift templates and per-day schedule mapping.
// % Model jadwal kerja untuk template shift dan mapping jadwal per hari.

model Shifts {
  id        String @id @default(uuid())
  name      String // Misal: "Shift Pagi", "Normal Day"
  startTime String // "08:00"
  endTime   String // "17:00"

  isCrossDay Boolean  @default(false) // Untuk handle shift yang melewati tengah malam
  createdAt  DateTime @default(now())

  // Relasi ke detail hari
  // workingScheduleId String?
  // workingSchedule   WorkingSchedules? @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)

  scheduleDays ScheduleDays[]
}

model WorkingSchedules {
  id        String   @id @default(uuid())
  name      String // Misal: "Jadwal Operasional Kantor"
  createdAt DateTime @default(now())

  days      ScheduleDays[]
  // shifts    Shifts[]
  employees Employees[]
}

model ScheduleDays {
  id        String  @id @default(uuid())
  dayOfWeek String // "Monday", "Tuesday", dsb
  isActive  Boolean @default(true) // Untuk handle toggle Enable/Disable di UI

  // Relasi ke Master Shift
  shiftId String? // Nullable kalau isActive: false
  shift   Shifts? @relation(fields: [shiftId], references: [id])

  workingScheduleId String
  workingSchedule   WorkingSchedules @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)

  @@unique([workingScheduleId, dayOfWeek])
}

model PublicHolidays {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @unique @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// & Attendance and audit models for presence records and traceability.
// % Model absensi dan audit untuk pencatatan kehadiran serta jejak perubahan.

// Jadwal absensi user
// model Schedules {
//   id         String   @id @default(uuid())
//   name       String? // contoh: "Jadwal 1"
//   daysOfWeek String // contoh: "Mon,Tue,Wed,Thu,Fri"
//   createdAt  DateTime @default(now())
//   updatedAt  DateTime @updatedAt

//   // shiftSchedulePivots ShiftSchedulePivot[]
//   employees Employees[]
// }

// Data absensi
model Attendances {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employees @relation(fields: [employeeId], references: [id])

  shiftNameSnapshot        String // Misal: "Pagi"
  expectedCheckInSnapshot  DateTime // Jam masuk yang seharusnya (diambil dari Shift saat itu)
  expectedCheckOutSnapshot DateTime? // Jam pulang yang seharusnya

  // // DATA SNAPSHOT (Waktu sesuai jadwal)
  // shiftStartTimeSnapshot DateTime  @db.Time() // Jam mulai shift (snapshot)
  // shiftEndTimeSnapshot   DateTime? @db.Time() // Jam selesai shift (snapshot)

  // REAL DATA (Waktu aslinya)
  checkIn  DateTime?
  checkOut DateTime?

  isManualEntry    Boolean   @default(false) // tandain ini manual atau otomatis
  manualReason    String? // "Forgot clock-in", "Technical issue", dll
  manualNotes     String?   @db.Text // Additional notes dari UI
  manualEntryBy   String? // userId admin yang input
  manualEntryAt   DateTime? // kapan admin input ini
  manualEntryByRole String? // snapshot role admin saat entry dilakukan

  // Relasi ke admin yang input
  manualEntryUser Users? @relation("ManualEntryBy", fields: [manualEntryBy], references: [id])

  // Lokasi absensi (nama tempat)
  deviceInfo String? @db.Text

  // Metode absensi: FACE_RECOGNITION 
  checkInPhoto  String? @db.Text
  checkOutPhoto String? @db.Text

  // Status absensi: PRESENT, LATE, ABSENT, LEAVE, OFF
  status         AttendanceStatus  @default(OFF)
  statusCheckOut AttendanceStatus? // Status saat check out (bisa null kalau belum check out)

  latitudeCheckInSnapshot  Decimal? @db.Decimal(10, 7) // lokasi absensi check in
  longitudeCheckInSnapshot Decimal? @db.Decimal(10, 7) // lokasi absensi check in

  latitudeCheckOutSnapshot  Decimal? @db.Decimal(10, 7) // lokasi absensi check out
  longitudeCheckOutSnapshot Decimal? @db.Decimal(10, 7) // lokasi absensi check out

  radiusCheckInSnapshot  Int? // radius geofence saat check-in
  radiusCheckOutSnapshot Int? // radius geofence saat check-out

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  geofencesId String?

  geofences Geofences? @relation("AttendanceCheckIn", fields: [geofencesId], references: [id])

  geofencesCheckOutId String?

  geofencesCheckOut Geofences? @relation("AttendanceCheckOut", fields: [geofencesCheckOutId], references: [id])

  // & Point wallet integration fields
  // % Field integrasi dompet integritas
  pointsEarned    Int?     // Poin yang diperoleh dari absensi ini
  usedTokenId     String?  @unique // FK ke UserTokens.id (must be unique for one-to-one)
  usedToken       UserTokens? @relation("AttendanceUsedToken", fields: [usedTokenId], references: [id], onDelete: SetNull)
}

model AuditLogs {
  id        String   @id @default(uuid())
  action    String // Misal: "UPDATE_ATTENDANCE_MANUAL"
  entity    String // Misal: "Attendances"
  entityId  String // ID dari data absensi yang diedit
  userId    String // ID si Admin HRD yang ngedit
  userRole  String // Misal: "ADMIN"
  changes   Json // Nyimpen data sebelum & sesudah diedit { before: {...}, after: {...} }
  reason    String? // Alasan ngedit: "HP karyawan mati, diwakilin"
  createdAt DateTime @default(now())
}

