model Geofences {
  id                  String        @id @default(uuid())
  name                String
  latitude            Decimal       @db.Decimal(10, 7)
  longitude           Decimal       @db.Decimal(10, 7)
  radius              Int // dalam meter
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  attendancesCheckIn  Attendances[] @relation("AttendanceCheckIn")
  attendancesCheckOut Attendances[] @relation("AttendanceCheckOut")
}

// & Submission enums and models used by employee request workflow.
// % Enum dan model pengajuan yang dipakai alur request karyawan.
enum SubmissionType {
  IZIN_SAKIT
  IZIN_KHUSUS
  DINAS_LUAR
  LEMBUR
  GANTI_SHIFT_HARI
}

enum SubmissionStatus {
  PENDING // Menunggu (Warna Kuning/Abu)
  APPROVED // Disetujui (Warna Hijau)
  REJECTED // Ditolak (Warna Merah)
}

// ==========================================
// & MODEL PENGAJUAN
// ==========================================
model Submissions {
  id     String @id @default(uuid())
  userId String

  // Data dari Form Karyawan
  type       SubmissionType // Dropdown "Tipe Pengajuan"
  startDate  DateTime // "Tanggal Mulai"
  endDate    DateTime // "Tanggal Selesai"
  reason     String         @db.Text // Text Area "Alasan"
  attachment String? // URL file lampiran di Cloudinary
  attachmentPublicId String? // public_id Cloudinary untuk kebutuhan cleanup saat delete
  attachmentOriginalName String?
  attachmentMimeType String?
  attachmentSizeBytes Int?

  // Data dari HRD / Sistem
  status          SubmissionStatus @default(PENDING) // Status awal selalu PENDING
  rejectionReason String?          @db.Text // Alasan kalau ditolak HRD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke tabel Users yang udah lu punya
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// & Work schedule models for shift templates and per-day schedule mapping.
// % Model jadwal kerja untuk template shift dan mapping jadwal per hari.

model Shifts {
  id        String @id @default(uuid())
  name      String // Misal: "Shift Pagi", "Normal Day"
  startTime String // "08:00"
  endTime   String // "17:00"

  isCrossDay Boolean  @default(false) // Untuk handle shift yang melewati tengah malam
  createdAt  DateTime @default(now())

  // Relasi ke detail hari
  // workingScheduleId String?
  // workingSchedule   WorkingSchedules? @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)

  scheduleDays ScheduleDays[]
}

model WorkingSchedules {
  id        String   @id @default(uuid())
  name      String // Misal: "Jadwal Operasional Kantor"
  createdAt DateTime @default(now())

  days      ScheduleDays[]
  // shifts    Shifts[]
  employees Employees[]
}

model ScheduleDays {
  id        String  @id @default(uuid())
  dayOfWeek String // "Monday", "Tuesday", dsb
  isActive  Boolean @default(true) // Untuk handle toggle Enable/Disable di UI

  // Relasi ke Master Shift
  shiftId String? // Nullable kalau isActive: false
  shift   Shifts? @relation(fields: [shiftId], references: [id])

  workingScheduleId String
  workingSchedule   WorkingSchedules @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)

  @@unique([workingScheduleId, dayOfWeek])
}

model PublicHolidays {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @unique @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// & Attendance and audit models for presence records and traceability.
// % Model absensi dan audit untuk pencatatan kehadiran serta jejak perubahan.

// Jadwal absensi user
