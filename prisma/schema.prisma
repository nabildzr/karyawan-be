model EmployeeDetails {
  employeeId        String    @id
  employee          Employees @relation(fields: [employeeId], references: [id])
  dateOfBirth       DateTime? @db.Date
  placeOfBirth      String?
  gender            String?
  maritalStatus     String?
  religion          String?
  profilePictureUrl String?
  bankName          String?
  bankAccountNumber String?
  hireDate          DateTime? @db.Date
  employmentType    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// & Assessment performance models used by evaluator workflow.
// % Model penilaian kinerja yang dipakai alur evaluator.

model AssessmentCategories {
  id          String  @id @default(uuid())
  name        String // "Kerja Sama", "Inisiatif", "Kedisiplinan"
  description String? @db.Text
  type        String? // Buat filter: "Employee", "Managerial"
  isActive    Boolean @default(true)

  // Fitur Rahasia (Req #4): Admin bisa nentuin nilai ini boleh diliat bawahan atau nggak
  isVisibleToEmployee Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentDetails AssessmentDetails[]
}

model Assessments {
  id String @id @default(uuid())

  // Siapa yang menilai (Manager / HRD) -> Relasi ke tabel Users
  evaluatorId String
  evaluator   Users  @relation("EvaluatorRelation", fields: [evaluatorId], references: [id])

  // Siapa yang dinilai (Bawahan / Staff) -> Relasi ke tabel Employees
  evaluateeId String
  evaluatee   Employees @relation("EvaluateeRelation", fields: [evaluateeId], references: [id])

  assessmentDate DateTime @db.Date
  period         String // "Minggu 1 Jan 2026", "Q1 2026", "Semester 1"
  generalNotes   String?  @db.Text // Kesimpulan / Feedback text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  details AssessmentDetails[]
}

model AssessmentDetails {
  id String @id @default(uuid())

  assessmentId String
  assessment   Assessments @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  categoryId String
  category   AssessmentCategories @relation(fields: [categoryId], references: [id])

  categoryName String // Snapshot nama kategori saat penilaian dibuat (biar gak berubah walaupun kategori diubah kemudian)

  // Pake Decimal biar bisa ngasih nilai 4.5 atau 8.5
  score Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Biar 1 form penilaian gak ada kategori yang dobel/diisi dua kali
  @@unique([assessmentId, categoryId])
}

