// * File schema database: prisma/schema.prisma
// & This schema defines identity, RBAC, HR, attendance, submission, and audit domains.
// % Schema ini mendefinisikan domain identitas, RBAC, HR, absensi, pengajuan, dan audit.

// & Prisma client generators used by backend runtime and validation types.
// % Generator Prisma client yang dipakai runtime backend dan tipe validasi.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  additionalProperties        = true
  inputModel                  = true
  output                      = "../src/generated/prismabox"
}

datasource db {
  provider = "postgresql"
}

// & Shared enums used by RBAC and attendance-related models.
// % Enum bersama yang dipakai model RBAC dan model terkait absensi.

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
}

enum AttendanceStatus {
  PRESENT // Hadir tepat waktu
  LATE // Telat
  ABSENT // Alpa / Gak masuk
  LEAVE // Izin / Cuti
  OFF // Memang jadwalnya libur
}

// & Core identity and RBAC authorization models.
// % Model inti identitas user dan otorisasi RBAC.

model Users {
  id        String   @id @default(uuid())
  nip       String   @unique
  password  String
  rbacRoleId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // & Point wallet denormalized fields for performance
  // % Field integritas dompet untuk performa
  currentPoints   Int     @default(0)

  rbacRole RbacRoles? @relation(fields: [rbacRoleId], references: [id])

  managedDivisions Divisions[]   @relation("DivisionManager")
  evaluationsGiven Assessments[] @relation("EvaluatorRelation")

  employees   Employees?
  
  userFaces   UserFaces?
  submissions Submissions[]
  manualEntryAttendances Attendances[] @relation("ManualEntryBy")
  
  // & Point wallet relations
  // % Relasi dompet integritas
  pointLedgers PointLedgers[]
  userTokens   UserTokens[]

  // & Notifications relations
  // % Relasi untuk sistem notifikasi
  notifications Notifications[]
  pushSubscriptions PushSubscriptions[]
}

// & Gamification models for badges and points.
// % Model gamifikasi untuk badge dan poin.
enum NotificationCategory {
  ATTENDANCE      // Notif absensi (check-in/out berhasil, absen)
  POINTS          // Riwayat poin (earn, penalty, adjustment)
  SCHEDULE        // Perubahan jadwal kerja
  ASSESSMENT      // Dinilai oleh supervisor/evaluator
  SUBMISSION      // Pengajuan disetujui/ditolak
  GENERAL         // Lainnya
}

model Notifications {
  id          String               @id @default(uuid())
  userId      String
  user        Users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  body        String               @db.Text
  category    NotificationCategory @default(GENERAL)
  isRead      Boolean              @default(false)
  readAt      DateTime?

  // Referensi opsional ke entitas terkait
  referenceEntity String?          // "attendance", "submission", "assessment", etc.
  referenceId     String?          // UUID entity terkait

  // Web Push metadata
  pushSent    Boolean              @default(false)
  pushSentAt  DateTime?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, isRead, createdAt])
  @@index([userId, category])
}

model PushSubscriptions {
  id         String   @id @default(uuid())
  userId     String
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([userId])
}

model RbacRoles {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  canAccessAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       Users[]
  permissions RolePermissionActions[]
}

model PermissionResources {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  routePath       String?
  groupName       String?
  supportsApprove Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permissions RolePermissionActions[]
}

model RolePermissionActions {
  id         String           @id @default(uuid())
  roleId     String
  resourceId String
  action     PermissionAction
  isAllowed  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  role     RbacRoles           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource PermissionResources @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([roleId, resourceId, action])
  @@index([roleId])
  @@index([resourceId])
}

model Positions {
  id        String @id @default(uuid())
  name      String
  gajiPokok Int

  // Untuk menentukan level akses (e.g., Supervisor ke atas)
  isManagerial Boolean @default(false)

  // gajiPokok Decimal     @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //? satu divisi
  divisionId String?
  division   Divisions? @relation(fields: [divisionId], references: [id])

  employees Employees[]
}

model Divisions {
  id          String  @id @default(uuid())
  name        String
  description String?

  managerId String? @unique
  manager   Users?  @relation("DivisionManager", fields: [managerId], references: [id])

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  positions Positions[]
}

model Employees {
  id       String  @id @default(uuid())
  fullName String
  address  String?

  email       String? @unique
  phoneNumber String? @unique

  joinDate DateTime @default(now())

  userId String @unique
  user   Users  @relation(references: [id], fields: [userId])

  positionId String?
  position   Positions? @relation(references: [id], fields: [positionId])

  // scheduleId String?
  // schedule   Schedules? @relation(references: [id], fields: [scheduleId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationsReceived Assessments[] @relation("EvaluateeRelation")

  employeeDetails    EmployeeDetails[]
  attendances        Attendances[]
  // shiftSchedulePivots     ShiftSchedulePivot[]
  workingSchedules   WorkingSchedules? @relation(fields: [workingSchedulesId], references: [id])
  workingSchedulesId String?
}

